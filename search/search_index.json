 <li>\u200b\u76ee\u7684\u200b: Canva\uff08\u30c7\u30b6\u30a4\u30f3\u200b\u5236\u4f5c\u200b\uff09\u3084\u200b\u751f\u6210\u200bAI\u3092\u200b\u6d3b\u200b\u7528\u200b\u3057\u3001\u200b\u5728\u200b\u5b85\u200b\u30ef\u30fc\u30af\u3084\u30af\u30e9\u30a6\u30c9\u30bd\u30fc\u30b7\u30f3\u30b0\u200b\u7b49\u200b\u3067\u200b\u5b9f\u200b\u969b\u200b\u306b\u200b\u53ce\u200b\u5165\u200b\u3092\u200b\u7372\u5f97\u200b\u30fb\u200b\u81ea\u7acb\u200b\u3067\u304d\u308b\u30d9\u30fc\u30b9\u3092\u200b\u69cb\u7bc9\u200b\u3059\u308b\u3002</li> <li>\u200b\u671f\u9593\u200b: \u200b\u5168\u4f53\u200b\u3067\u200b\u7d04\u200b3\u30f6\u200b\u6708\u9593\u200b\uff08\u200b\u8b1b\u7fa9\u200b\uff1a9\u200b\u6708\u200b\u301c10\u200b\u6708\u672b\u200b \uff0f \u200b\u5b9f\u200b\u8df5\u200bOJT\uff1a11\u200b\u6708\u672b\u200b\u307e\u3067\uff09</li> <li>\u200b\u904b\u200b\u55b6\u200b\u4f53\u5236\u200b:</li> <li>\u30e1\u30a4\u30f3\u200b\u8b1b\u5e2b\u200b\uff08SNS\u30fbCanva\u30fbAI\u30fb\u200b\u6848\u4ef6\u200b\u7372\u5f97\u200b\u5168\u822c\u200b\uff09</li> <li>\u200b\u8d64\u77f3\u200b\u6ca2\u200b \u200b\u6c0f\u200b\uff08\u200b\u52d5\u753b\u200b\u7de8\u96c6\u200b\u30fb\u30b7\u30e7\u30fc\u30c8\u200b\u52d5\u753b\u200b\u62c5\u5f53\u200b\u56de\u200b\uff09</li> <li>\u200b\u9ed2\u200b\u5bae\u200b \u30ca\u200b\u5b50\u200b \u200b\u6c0f\u200b\uff08\u200b\u5bbf\u984c\u200b\u30c1\u30a7\u30c3\u30af\u30fb\u200b\u8cea\u554f\u200b\u5bfe\u200b\u5fdc\u200b\u30fb\u30b5\u30dd\u30fc\u30c8\u200b\u62c5\u5f53\u200b \u203b\u30aa\u30f3\u30e9\u30a4\u30f3\u200b\u53c2\u52a0\u200b\uff09</li> </ul>"},{"location":"posts/20260830iroenpitsu/#2","title":"2. \u30b9\u30b1\u30b8\u30e5\u30fc\u30eb\u30fb\u200b\u958b\u200b\u50ac\u5834\u200b\u6240\u200b\u4e00\u200b\u89a7","text":"<p>\u200b\u539f\u5247\u200b\u3068\u3057\u3066 \u200b\u6bce\u200b\u9031\u6c34\u66dc\u200b\u65e5\u200b 10:00\u301c12:00 \u306b\u200b\u958b\u200b\u50ac\u200b\u3055\u308c\u307e\u3059\uff08\u203b\u200b\u5bfe\u200b\u9762\u958b\u200b\u50ac\u200b\uff09\u3002</p> \u200b\u6708\u200b \u200b\u65e5\u7a0b\u200b \u200b\u958b\u200b\u50ac\u5834\u200b\u6240\u200b \u200b\u5099\u8003\u200b\u30fb\u200b\u7279\u8a18\u200b\u4e8b\u9805\u200b 9\u200b\u6708\u200b 9\u200b\u6708\u200b2\u200b\u65e5\u200b(\u200b\u6c34\u200b) CoCoDe\uff08\u30b3\u30b3\u30c7\uff09 \u200b\u521d\u56de\u200b\u5bfe\u200b\u9762\u200b\u8b1b\u7fa9\u200b\uff08Wi-Fi\u200b\u7b49\u200b\u4e0d\u5b89\u200b\u306a\u200b\u65b9\u200b\u306f 9:50\u200b\u958b\u5834\u200b \u306b\u200b\u6765\u5834\u200b\uff09 9\u200b\u6708\u200b9\u200b\u65e5\u200b(\u200b\u6c34\u200b) CoCoDe\uff08\u30b3\u30b3\u30c7\uff09 \u200b\u99d0\u8eca\u5834\u200b\u3042\u308a\uff08\u200b\u8eca\u6765\u5834\u200b\u53ef\u200b\uff09 9\u200b\u6708\u200b16\u200b\u65e5\u200b(\u200b\u6c34\u200b) CoCoDe\uff08\u30b3\u30b3\u30c7\uff09 \u200b\u99d0\u8eca\u5834\u200b\u3042\u308a\uff08\u200b\u8eca\u6765\u5834\u200b\u53ef\u200b\uff09 9\u200b\u6708\u200b24\u200b\u65e5\u200b(\u200b\u6c34\u200b) \u304a\u200b\u4f11\u200b\u307f\uff08\u200b\u4f11\u8b1b\u200b\uff09 \u203b\u200b\u8b1b\u7fa9\u200b\u306f\u3042\u308a\u307e\u305b\u3093\u3002\u200b\u9593\u200b\u9055\u200b\u3048\u3066\u200b\u6765\u5834\u200b\u3057\u306a\u3044\u3088\u3046\u200b\u6ce8\u610f\u200b 10\u200b\u6708\u200b 10\u200b\u6708\u200b7\u200b\u65e5\u200b(\u200b\u6c34\u200b) \u30b5\u30a4\u30d1\u30eb\uff08\u200b\u65ed\u5ddd\u200b\u5e02\u200b\u79d1\u5b66\u200b\u9928\u200b\uff09 \u200b\u4f1a\u5834\u200b\u5909\u200b\u66f4\u200b\u306b\u200b\u6ce8\u610f\u200b / \u200b\u99d0\u8eca\u5834\u200b\u3042\u308a\uff08\u200b\u8eca\u6765\u5834\u200b\u53ef\u200b\uff09 10\u200b\u6708\u200b14\u200b\u65e5\u200b(\u200b\u6c34\u200b) \u30b5\u30a4\u30d1\u30eb\uff08\u200b\u65ed\u5ddd\u200b\u5e02\u200b\u79d1\u5b66\u200b\u9928\u200b\uff09 10\u200b\u6708\u200b21\u200b\u65e5\u200b(\u200b\u6c34\u200b) \u30b5\u30a4\u30d1\u30eb\uff08\u200b\u65ed\u5ddd\u200b\u5e02\u200b\u79d1\u5b66\u200b\u9928\u200b\uff09 10\u200b\u6708\u200b28\u200b\u65e5\u200b(\u200b\u6c34\u200b) \u30b5\u30a4\u30d1\u30eb\uff08\u200b\u65ed\u5ddd\u200b\u5e02\u200b\u79d1\u5b66\u200b\u9928\u200b\uff09 11\u200b\u6708\u200b 1\u30f6\u200b\u6708\u9593\u200b \u30aa\u30f3\u30e9\u30a4\u30f3\u200b\u5b9f\u200b\u65bd\u200b \u200b\u5b9f\u200b\u8df5\u200bOJT\u200b\u671f\u9593\u200b\uff08\u200b\u7121\u200b\u5831\u916c\u200b\u3067\u3059\u304c\u200b\u5b9f\u200b\u30af\u30e9\u30a4\u30a2\u30f3\u30c8\u200b\u7b49\u200b\u306e\u200b\u5236\u4f5c\u200b\u5b9f\u200b\u7e3e\u200b\u30fb\u30dd\u30fc\u30c8\u30d5\u30a9\u30ea\u30aa\u200b\u4f5c\u200b\u308a\uff09"},{"location":"posts/20260830iroenpitsu/#3-todo","title":"3. \u200b\u53d7\u200b\u8b1b\u8005\u200b\u304c\u200b\u4eca\u200b\u5f8c\u200b\u3084\u308b\u3079\u304d\u3053\u3068\uff08ToDo\u30ea\u30b9\u30c8\uff09","text":""},{"location":"posts/20260830iroenpitsu/#1_1","title":"\u2460 \u200b\u6b21\u56de\u200b\uff08\u200b\u521d\u56de\u200b\u5bfe\u200b\u9762\u200b\uff09\u307e\u3067\u306b\u200b\u6e96\u5099\u200b\u3059\u308b\u3053\u3068","text":"<ul> <li> Discord\u306e\u200b\u74b0\u5883\u200b\u8a2d\u5b9a\u200b</li> <li>PC\u306bDiscord\uff08\u30d6\u30e9\u30a6\u30b6\u200b\u7248\u200b\u307e\u305f\u306f\u30a2\u30d7\u30ea\u200b\u7248\u200b\u63a8\u200b\u5968\u200b\uff09\u3092\u200b\u5c0e\u5165\u200b\u3057\u3001\u30ed\u30b0\u30a4\u30f3\u3067\u304d\u308b\u200b\u72b6\u614b\u200b\u306b\u3059\u308b\u3002</li> <li>\u30b9\u30de\u30db\u306b\u3082\u30a2\u30d7\u30ea\u3092\u200b\u5165\u200b\u308c\u3066\u304a\u304f\u3068\u200b\u7dca\u6025\u200b\u9023\u7d61\u6642\u200b\u306b\u200b\u4fbf\u5229\u200b\u3002</li> <li>\u300cR8\u200b\u65ed\u5ddd\u200b\u5e02\u4e3b\u200b\u50ac\u200b\u30bb\u30df\u30ca\u30fc\u200b\u4e8b\u696d\u200b\u300d\u30b5\u30fc\u30d0\u30fc\u306b\u200b\u53c2\u52a0\u200b\u3059\u308b\u3002</li> <li>\u30c1\u30e3\u30f3\u30cd\u30eb <code>001_\u200b\u81ea\u5df1\u200b\u7d39\u4ecb\u200b</code> \u306b\u200b\u81ea\u5df1\u200b\u7d39\u4ecb\u200b\uff08\u200b\u540d\u524d\u200b\u3001\u200b\u597d\u200b\u304d\u306a\u200b\u98df\u200b\u3079\u200b\u7269\u200b\u3001\u200b\u51fa\u8eab\u200b\u5730\u200b\u3001\u200b\u4efb\u610f\u200b\u3067\u200b\u5acc\u200b\u3044\u306a\u200b\u98df\u200b\u3079\u200b\u7269\u200b\uff09\u3092\u200b\u6295\u7a3f\u200b\u3059\u308b\u3002</li> <li> <p>\u200b\u4ed6\u200b\u306e\u200b\u53c2\u52a0\u8005\u200b\u306e\u200b\u81ea\u5df1\u200b\u7d39\u4ecb\u200b\u306b\u30b9\u30bf\u30f3\u30d7\u3067\u30ea\u30a2\u30af\u30b7\u30e7\u30f3\u3092\u200b\u9001\u200b\u308b\u3002</p> </li> <li> <p> Canva\u306e\u200b\u7121\u6599\u200b\u30a2\u30ab\u30a6\u30f3\u30c8\u200b\u4f5c\u6210\u200b\u30fb\u30ed\u30b0\u30a4\u30f3\u200b\u78ba\u8a8d\u200b</p> </li> <li> <p>\u30a2\u30ab\u30a6\u30f3\u30c8\u200b\u767b\u200b\u9332\u200b\u3092\u200b\u6e08\u200b\u307e\u305b\u3066\u304a\u304f\uff08\u200b\u7121\u6599\u200b\u30d7\u30e9\u30f3\u3067\u200b\u53ef\u200b\u3002\u30a2\u30d7\u30ea\u306e\u30a4\u30f3\u30b9\u30c8\u30fc\u30eb\u306f\u200b\u4efb\u610f\u200b\u3067\u30d6\u30e9\u30a6\u30b6\u200b\u7248\u200b\u3067\u3082OK\uff09\u3002</p> </li> <li> <p> \u200b\u81ea\u5df1\u200b\u7d39\u4ecb\u200b\u4f5c\u6210\u200b\u7528\u200b\u306e\u200b\u753b\u50cf\u200b\u7d20\u6750\u200b\u306e\u200b\u6e96\u5099\u200b</p> </li> <li> <p>\u200b\u6b21\u56de\u200b\u306e\u200b\u5bfe\u200b\u9762\u200b\u8b1b\u7fa9\u200b\u3067\u200b\u81ea\u5df1\u200b\u7d39\u4ecb\u200b\u753b\u50cf\u200b\u3092\u200b\u4f5c\u6210\u200b\u3059\u308b\u305f\u3081\u3001\u200b\u81ea\u8eab\u200b\u306e\u200b\u5199\u771f\u200b\u3001\u30a4\u30e9\u30b9\u30c8\u30fb\u30a2\u30a4\u30b3\u30f3\u3001\u30da\u30c3\u30c8\u3084\u200b\u98a8\u666f\u200b\u306e\u200b\u5199\u771f\u200b\u306a\u3069\u3001\u200b\u4f7f\u7528\u200b\u3057\u305f\u3044\u200b\u753b\u50cf\u200b\u30c7\u30fc\u30bf\u3092PC\u307e\u305f\u306fCanva\u306b\u30a2\u30c3\u30d7\u30ed\u30fc\u30c9\u3067\u304d\u308b\u3088\u3046\u200b\u6e96\u5099\u200b\u3057\u3066\u304a\u304f\u3002</p> </li> <li> <p> \uff08\u200b\u8a2d\u5b9a\u200b\u7b49\u200b\u306b\u200b\u4e0d\u5b89\u200b\u304c\u3042\u308b\u200b\u5834\u5408\u200b\uff09\u200b\u65e9\u200b\u3081\u306e\u200b\u6765\u5834\u200b</p> </li> <li>Wi-Fi\u200b\u63a5\u200b\u7d9a\u200b\u3084\u30ed\u30b0\u30a4\u30f3\u200b\u8a2d\u5b9a\u200b\u306b\u200b\u4e0d\u5b89\u200b\u304c\u3042\u308b\u200b\u65b9\u200b\u306f\u3001\u200b\u6b21\u56de\u200b 9:50\uff08\u200b\u958b\u5834\u200b\u6642\u9593\u200b\uff09\u306b\u200b\u6765\u5834\u200b\u3057\u3066\u30b5\u30dd\u30fc\u30c8\u3092\u200b\u53d7\u200b\u3051\u308b\u3002</li> <li>\u200b\u81ea\u529b\u200b\u3067\u306e\u200b\u8a2d\u5b9a\u200b\u304c\u200b\u5b8c\u5168\u200b\u306b\u200b\u56f0\u96e3\u200b\u306a\u200b\u5834\u5408\u200b\u306f\u3001\u200b\u4e8b\u524d\u200b\u306b\u200b\u8b1b\u5e2b\u200b\u3078\u200b\u9023\u7d61\u200b\u3057\u3066\u200b\u500b\u5225\u200b\u8abf\u6574\u200b\u3092\u200b\u4f9d\u200b\u983c\u200b\u3059\u308b\u3002</li> </ul>"},{"location":"posts/20260830iroenpitsu/#2_1","title":"\u2461 \u200b\u65e5\u5e38\u200b\u7684\u200b\u30fb\u200b\u7d99\u200b\u7d9a\u200b\u7684\u200b\u306b\u200b\u53d6\u200b\u308a\u200b\u7d44\u200b\u3080\u3053\u3068","text":"<ul> <li> \u30bf\u30a4\u30d4\u30f3\u30b0\u306e\u200b\u7df4\u7fd2\u200b\uff08\u200b\u5bff\u53f8\u200b\u6253\u200b\uff09</li> <li> <p>\u200b\u5728\u200b\u5b85\u200b\u30ef\u30fc\u30af\u3067\u306e\u200b\u5236\u4f5c\u200b\u30fb\u200b\u5165\u529b\u200b\u30b9\u30d4\u30fc\u30c9\u200b\u5411\u4e0a\u200b\u306e\u305f\u3081\u3001\u30bf\u30a4\u30d4\u30f3\u30b0\u200b\u7df4\u7fd2\u200b\u30b5\u30a4\u30c8\u300c\u200b\u5bff\u53f8\u200b\u6253\u200b\u300d\u306e\u200b\u9ad8\u7d1a\u200b1\u200b\u4e07\u5186\u200b\u30b3\u30fc\u30b9\u200b\u5408\u683c\u200b\u3092\u200b\u76ee\u6307\u200b\u3057\u3066\u200b\u7df4\u7fd2\u200b\u3092\u200b\u91cd\u200b\u306d\u308b\u3002</p> </li> <li> <p> \u200b\u751f\u6210\u200bAI\uff08ChatGPT / Claude / Gemini\u306a\u3069\uff09\u306b\u200b\u89e6\u200b\u308c\u3066\u304a\u304f</p> </li> <li> <p>\u200b\u65e5\u5e38\u200b\u306e\u200b\u7591\u554f\u200b\u89e3\u6d88\u200b\u3084\u200b\u732e\u7acb\u200b\u4f5c\u6210\u200b\u3001\u200b\u6587\u7ae0\u200b\u306e\u200b\u8a00\u200b\u3044\u200b\u63db\u200b\u3048\u306a\u3069\u3001\u200b\u7121\u6599\u200b\u7248\u200b\u304b\u3089\u200b\u6c17\u200b\u8efd\u200b\u306b\u200b\u4f7f\u200b\u3063\u3066\u307f\u308b\u3002</p> </li> <li> <p> \u200b\u4ed6\u8005\u200b\u306e\u30c7\u30b6\u30a4\u30f3\u30fbSNS\u200b\u6295\u7a3f\u200b\u306e\u30ea\u30b5\u30fc\u30c1</p> </li> <li> <p>\u200b\u826f\u200b\u3044\u30c7\u30b6\u30a4\u30f3\u3084\u30c8\u30ec\u30f3\u30c9\u3092\u200b\u77e5\u200b\u308b\u305f\u3081\u3001\u200b\u65e5\u5e38\u200b\u7684\u200b\u306b\u200b\u4eba\u200b\u306e\u30b3\u30f3\u30c6\u30f3\u30c4\u3092\u200b\u89b3\u200b\u5bdf\u200b\u3059\u308b\u200b\u7656\u200b\u3092\u3064\u3051\u308b\u3002</p> </li> <li> <p> \u200b\u8b1b\u7fa9\u5f8c\u200b\u306e\u200b\u5bbf\u984c\u200b\u63d0\u51fa\u200b\uff08\u200b\u4efb\u610f\u200b\uff09</p> </li> <li>\u200b\u6bce\u200b\u9031\u51fa\u200b\u3055\u308c\u308b\u200b\u8ab2\u984c\u200b\u3092\u200b\u4f5c\u6210\u200b\u3057\u3001Discord\u306e <code>005_\u200b\u5bbf\u984c\u200b\u63d0\u51fa\u200b</code> \u306b\u200b\u63d0\u51fa\u200b\u3057\u3066\u30d5\u30a3\u30fc\u30c9\u30d0\u30c3\u30af\u3092\u3082\u3089\u3046\u3002</li> </ul>"},{"location":"posts/20260830iroenpitsu/#4-discord","title":"4. Discord \u30c1\u30e3\u30f3\u30cd\u30eb\u306e\u200b\u4f7f\u200b\u3044\u200b\u5206\u200b\u3051","text":"<p>\u200b\u8b1b\u5ea7\u200b\u671f\u9593\u200b\u4e2d\u200b\u306e\u200b\u9023\u7d61\u200b\u30fb\u3084\u308a\u200b\u53d6\u200b\u308a\u306f\u3059\u3079\u3066Discord\u3067\u200b\u884c\u200b\u308f\u308c\u307e\u3059\u3002</p> <ul> <li><code>000_\u200b\u4e8b\u52d9\u9023\u7d61\u200b</code>: \u200b\u904b\u200b\u55b6\u200b\u304b\u3089\u306e\u200b\u9023\u7d61\u200b\u30fb\u200b\u958b\u200b\u50ac\u5834\u200b\u6240\u200b\u306e\u304a\u200b\u77e5\u200b\u3089\u305b\u306a\u3069</li> <li><code>001_\u200b\u81ea\u5df1\u200b\u7d39\u4ecb\u200b</code>: \u200b\u81ea\u5df1\u200b\u7d39\u4ecb\u200b\u30c6\u30ad\u30b9\u30c8\u30fb\u200b\u5236\u4f5c\u200b\u3057\u305f\u200b\u81ea\u5df1\u200b\u7d39\u4ecb\u200b\u753b\u50cf\u200b\u306e\u200b\u5171\u6709\u200b</li> <li><code>002_\u200b\u6b20\u5e2d\u200b\u9023\u7d61\u200b</code>: \u200b\u9045\u200b\u523b\u200b\u30fb\u200b\u6b20\u5e2d\u200b\u306e\u200b\u5c02\u200b\u7528\u200b\u9023\u7d61\u200b\u7a93\u200b\u53e3\u200b</li> <li><code>003_\u200b\u8cc7\u6599\u200b\u5171\u6709\u200b</code>: \u200b\u8b1b\u7fa9\u200b\u30b9\u30e9\u30a4\u30c9\u30fb\u200b\u9332\u200b\u753b\u200b\u30a2\u30fc\u30ab\u30a4\u30d6\u306e\u200b\u5171\u6709\u200b\u5834\u6240\u200b</li> <li><code>004_\u200b\u8b1b\u5ea7\u200b\u4e2d\u200b\u3084\u308a\u200b\u53d6\u200b\u308a</code>: \u200b\u8b1b\u7fa9\u4e2d\u200b\u306b\u30ea\u30a2\u30eb\u30bf\u30a4\u30e0\u3067\u200b\u4f7f\u7528\u200b\u3059\u308b\u30c1\u30e3\u30c3\u30c8</li> <li><code>005_\u200b\u5bbf\u984c\u200b\u63d0\u51fa\u200b</code>: \u200b\u5236\u4f5c\u200b\u8ab2\u984c\u200b\u306e\u200b\u63d0\u51fa\u200b\u5834\u6240\u200b\uff08\u200b\u9ed2\u200b\u5bae\u6c0f\u200b\u304c\u30c1\u30a7\u30c3\u30af\uff09</li> <li><code>006_\u200b\u8cea\u554f\u200b</code>: \u200b\u8b1b\u7fa9\u6642\u9593\u200b\u5916\u200b\u306e\u200b\u7591\u554f\u70b9\u200b\u3001Canva\u306e\u200b\u64cd\u4f5c\u200b\u3001\u200b\u8ab2\u984c\u200b\u306b\u200b\u95a2\u200b\u3059\u308b\u200b\u8cea\u554f\u200b\u53d7\u4ed8\u200b</li> <li>\u30c0\u30a4\u30ec\u30af\u30c8\u30e1\u30c3\u30bb\u30fc\u30b8\uff08DM\uff09: \u200b\u5168\u4f53\u200b\u306b\u200b\u516c\u958b\u200b\u3067\u304d\u306a\u3044\u200b\u500b\u200b\u4eba\u200b\u7684\u200b\u306a\u200b\u76f8\u8ac7\u6642\u200b\u306e\u307f\u200b\u4f7f\u7528\u200b\uff08\u200b\u8981\u200b\u30d5\u30ec\u30f3\u30c9\u200b\u7533\u8acb\u200b\uff09</li> </ul>"},{"location":"posts/20260830iroenpitsu/#5","title":"5. \u200b\u6ce8\u610f\u200b\u4e8b\u9805\u200b\u30fb\u30eb\u30fc\u30eb","text":"<ol> <li>\u200b\u6301\u200b\u3061\u200b\u7269\u200b</li> <li>\u30ce\u30fc\u30c8PC\uff08\u200b\u5fc5\u9808\u200b\uff09</li> <li>PC\u306e\u200b\u5145\u96fb\u5668\u200b\uff08AC\u30a2\u30c0\u30d7\u30bf\u30fc\uff09\uff08\u203b\u200b\u9014\u4e2d\u200b\u3067\u30d0\u30c3\u30c6\u30ea\u30fc\u200b\u5207\u200b\u308c\u306b\u306a\u3089\u306a\u3044\u3088\u3046\u200b\u5fc5\u200b\u305a\u200b\u6301\u53c2\u200b\uff09</li> <li> <p>\u200b\u7b46\u8a18\u200b\u7528\u5177\u200b\uff08\u200b\u5fc5\u8981\u200b\u306b\u200b\u5fdc\u200b\u3058\u3066\uff09</p> </li> <li> <p>\u200b\u6b20\u5e2d\u200b\u30fb\u200b\u9045\u200b\u523b\u6642\u200b\u306e\u30eb\u30fc\u30eb</p> </li> <li>\u200b\u5168\u200b\u65e5\u7a0b\u200b\u53c2\u52a0\u200b\u304c\u200b\u539f\u5247\u200b\u3067\u3059\u304c\u3001\u200b\u4f53\u8abf\u200b\u4e0d\u826f\u200b\u3084\u200b\u6025\u7528\u200b\u6642\u200b\u306f \u200b\u5fc5\u200b\u305aDiscord\u306e <code>002_\u200b\u6b20\u5e2d\u200b\u9023\u7d61\u200b</code> \u306b\u200b\u9023\u7d61\u200b\u3092\u200b\u5165\u200b\u308c\u308b\uff08\u200b\u7406\u7531\u200b\u306f\u200b\u8a73\u7d30\u200b\u306b\u200b\u66f8\u200b\u304b\u306a\u304f\u3066\u3082\u300c\u200b\u4f11\u200b\u307f\u307e\u3059\u300d\u3060\u3051\u3067\u200b\u53ef\u200b\u3002\u200b\u7121\u65ad\u200b\u6b20\u5e2d\u200b\u306f\u200b\u53b3\u200b\u7981\u200b\uff09\u3002</li> <li> <p>\u200b\u6b20\u5e2d\u200b\u3057\u305f\u200b\u5834\u5408\u200b\u3082 <code>003_\u200b\u8cc7\u6599\u200b\u5171\u6709\u200b</code> \u306b\u200b\u8b1b\u7fa9\u200b\u9332\u200b\u753b\u200b\u3068\u200b\u8cc7\u6599\u200b\u304c\u30a2\u30c3\u30d7\u30ed\u30fc\u30c9\u3055\u308c\u308b\u305f\u3081\u3001\u200b\u5404\u81ea\u200b\u3067\u200b\u5f8c\u200b\u304b\u3089\u30ad\u30e3\u30c3\u30c1\u30a2\u30c3\u30d7\u200b\u53ef\u80fd\u200b\u3002</p> </li> <li> <p>\u30b3\u30df\u30e5\u30cb\u30b1\u30fc\u30b7\u30e7\u30f3\u306e\u200b\u5fb9\u5e95\u200b</p> </li> <li> <p>\u200b\u5728\u200b\u5b85\u200b\u30ef\u30fc\u30af\u30fb\u30af\u30e9\u30a4\u30a2\u30f3\u30c8\u30ef\u30fc\u30af\u306e\u200b\u57fa\u790e\u200b\u3068\u3057\u3066\u3001\u200b\u6848\u5185\u200b\u3084\u200b\u9023\u7d61\u200b\u306b\u200b\u5bfe\u200b\u3057\u3066\u300c\u200b\u78ba\u8a8d\u200b\u3057\u305f\u300d\u3053\u3068\u304c\u200b\u4f1d\u200b\u308f\u308b\u3088\u3046\u3001\u30e1\u30c3\u30bb\u30fc\u30b8\u200b\u8fd4\u4fe1\u200b\u3084\u30b9\u30bf\u30f3\u30d7\u3067\u306e\u30ea\u30a2\u30af\u30b7\u30e7\u30f3\u3092\u200b\u5fc5\u200b\u305a\u200b\u884c\u200b\u3046\u3053\u3068\u3002</p> </li> <li> <p>AI\u306e\u200b\u5229\u7528\u200b\u306b\u200b\u95a2\u200b\u3059\u308b\u200b\u6ce8\u610f\u200b</p> </li> <li>AI\u306e\u200b\u51fa\u529b\u200b\u306f100%\u200b\u6b63\u78ba\u200b\u3068\u306f\u200b\u9650\u200b\u3089\u306a\u3044\u305f\u3081\u3001\u200b\u6587\u7ae0\u200b\u30fb\u200b\u753b\u50cf\u200b\u3068\u3082\u306b \u200b\u5fc5\u200b\u305a\u200b\u4eba\u9593\u200b\u306e\u200b\u76ee\u200b\u3067\u200b\u6700\u7d42\u200b\u30c1\u30a7\u30c3\u30af\u3092\u200b\u884c\u200b\u3046\u3053\u3068\u3002</li> <li>\u200b\u753b\u50cf\u200b\u751f\u6210\u200bAI\u306e\u200b\u9055\u548c\u611f\u200b\uff08AI\u200b\u7279\u6709\u200b\u306e\u200b\u4e0d\u200b\u81ea\u7136\u200b\u3055\uff09\u306b\u200b\u6ce8\u610f\u200b\u3057\u3001\u200b\u767a\u200b\u4fe1\u200b\u610f\u200b\u56f3\u200b\u3084\u30c7\u30b6\u30a4\u30f3\u306e\u200b\u57fa\u790e\u200b\u3092\u200b\u62bc\u200b\u3055\u3048\u305f\u200b\u4e0a\u200b\u3067\u200b\u88dc\u52a9\u200b\u7684\u200b\u306b\u200b\u6d3b\u200b\u7528\u200b\u3059\u308b\u3053\u3068\u3002</li> </ol>"}]}